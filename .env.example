# Every setting the app reads. Copy to .env (git-ignored) for local use; never commit the real .env or paste
# its values into chat. deploy/start-local.ps1 reads only the Cloudflare, geocoder contact and Google keys
# from .env, and sets the local database, storage and checker itself.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost/barangai
PRIVATE_MEDIA_DIR=./private_media
# Local files for development; use supabase for Render's ephemeral filesystem.
MEDIA_STORAGE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=incident-photos
# Set only when serving a built website from FastAPI (Render uses /app/static).
STATIC_SITE_DIR=
# Leave unset unless a proxy serves the API under a path of its own; Render's image mounts /api itself.
API_ROOT_PATH=
# seed_demo only: passwords of the synthetic demo accounts, one per role. Never set these on a hosted service.
# Staff and administrator passwords are generated and printed once when left empty.
SEED_DEMO_PASSWORD=
SEED_DEMO_STAFF_PASSWORD=
SEED_DEMO_ADMIN_PASSWORD=
# Shows a "Demo data" label on every screen and printed report, and in spreadsheets. Only for synthetic data;
# deploy/demo.ps1 sets it. Off by default, and the launcher never reads it from .env.
# DEMO_MODE=true
COOKIE_SECURE=false
MAX_IMAGE_BYTES=5000000
# Cap multipart bodies before parsing; configure the ingress/proxy request limit to 6000000 bytes or less as well.
MAX_REQUEST_BYTES=6000000
# Photos are shrunk to this many pixels on the long side before storage (the browser shrinks them first too).
MAX_IMAGE_EDGE=1600
# Best-effort face blurring before storage and before the vision model sees a photo; needs opencv-python-headless.
FACE_BLUR=on
PLATE_BLUR=on
# FACE_MODEL_PATH=apps/api/models/yunet/face_detection_yunet_2023mar.onnx
# Spam limits counted in the database per resident per 24 hours.
MAX_REPORTS_PER_DAY=10
MAX_ADDENDA_PER_DAY=20
# Abuse limits counted in the database (usage.py). Untuned starting values.
MAX_SIGNUPS_PER_HOUR=100
# Per network address, checked before the site-wide counters, so one device can't use them up. Generous, because
# people behind one router share an address; on the laptop's Wi-Fi each phone has its own.
MAX_SIGNUPS_PER_ADDRESS_PER_DAY=30
MAX_REPORTS_PER_ADDRESS_PER_DAY=100
# Wrong passwords in a Manila day, then 429 until the next one: per email and address, so a stranger can't lock the
# owner out, and per email from any address. A password reset clears both.
MAX_LOGIN_FAILURES_PER_DAY=50
MAX_LOGIN_FAILURES_PER_EMAIL_PER_DAY=500
MAX_PREVIEWS_PER_DAY=40
MAX_SITE_REPORTS_PER_DAY=300
# Cloudflare calls across the whole site; past these the checker or fixed guidance answers instead.
MAX_SITE_VISION_PER_DAY=1500
MAX_SITE_CHAT_AI_PER_DAY=500
POINTS_ACCEPTED=25
POINTS_RESOLVED=10
POINTS_FIRST=5
MAX_REWARDED_REPORTS_PER_DAY=5
VOUCHER_DAYS=30
MAX_DELETION_REQUESTS_PER_DAY=20
# Who runs the service and how to reach them, shown on the terms and privacy pages.
OPERATOR_NAME=
PRIVACY_CONTACT=
# Staff-only photo checks: pin more than this many metres from the photo's GPS, or a photo older than this.
LOCATION_MISMATCH_M=150
PHOTO_MAX_AGE_DAYS=7
# Number of proxies in front of the app that append to X-Forwarded-For (login limits use the address the outermost
# one recorded). Leave 0 until you have checked what your host sends; a wrong value lets callers pick their address.
TRUSTED_PROXY_HOPS=0
# Says no proxy exists, so a caller's X-Forwarded-For can't make callers look shared and skip the per-address limits.
# The launcher sets it; set it yourself when starting uvicorn by hand on a network.
DIRECT_CONNECTIONS=false
# Optional Workers AI: photo descriptions and chatbot guidance. Use a Workers Free account; keep the token
# server-side. The account ID is the 32-character code in the dashboard URL; the token comes from
# Manage Account > Account API Tokens, with the Workers AI > Edit permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=
# Optional: a different vision model (default @cf/mistralai/mistral-small-3.1-24b-instruct).
CLOUDFLARE_VISION_MODEL=
CLOUDFLARE_VISION_TIMEOUT=20
# Optional category checker and duplicate embeddings (MobileCLIP2-S0, ONNX). The launcher and the Render image
# set these; locally point CHECKER_MODEL_DIR at apps/api/models/mobileclip2-s0.
CHECKER_MODEL_DIR=
CHECKER_CONFIDENCE_THRESHOLD=0.5
CHECKER_THREADS=1
VALIDATED_EMBEDDING_MODEL_VERSION=
# Optional street names for report pins via OpenStreetMap Nominatim; add a contact email for its usage policy.
GEOCODER=
GEOCODER_CONTACT=
# Optional resident Google sign-in. Configure the exact public /api callback
# (locally http://127.0.0.1:8000/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
